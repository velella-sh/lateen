{
  "name": "@velella/lateen",
  "version": "0.2.4",
  "description": "A docs theme for people and agents, built on Mizzen.",
  "keywords": [
    "docs",
    "documentation",
    "markdown",
    "static-site",
    "agents",
    "velella",
    "theme",
    "rtl",
    "accessibility",
    "wcag"
  ],
  "homepage": "https://velella.sh/lateen/",
  "bugs": {
    "url": "https://github.com/velella-sh/lateen/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/velella-sh/lateen.git"
  },
  "license": "MIT",
  "type": "module",
  "packageManager": "npm@12.2.3",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": "./src/index.ts",
    "./visual": "./visual/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "tokens": "node scripts/tokens.ts",
    "tokens:check": "node scripts/tokens.ts --check",
    "ui:css": "tailwindcss -i styles/src/ui.css -o styles/generated.css --minify",
    "ui:assets": "esbuild scripts/chart-entry.ts --bundle --minify --format=esm --outfile=components/performance-chart/chart.min.js",
    "ui:build": "npm run ui:css && npm run ui:assets",
    "check:ui-build": "node scripts/check-ui-build.ts",
    "prepack": "npm run ui:build && npm run check:ui-build && node scripts/check-package.ts",
    "pretest": "npm run ui:build",
    "test": "node scripts/tokens.ts --check && node scripts/check-design.ts && node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./scripts/test-report.ts --test-reporter-destination=stdout \"test/**/*.test.ts\"",
    "test:a11y": "npm run ui:build && node scripts/test-a11y.ts",
    "test:screen-reader": "node --test test/screen-reader-audit.test.ts",
    "test:smoke": "npm run ui:build && node scripts/test-smoke.ts",
    "test:deployed": "node --test test/deployed-smoke.test.ts",
    "test:acceptance": "npm run ui:build && node scripts/acceptance.ts",
    "test:visual": "npm run ui:build && node scripts/test-visual.ts",
    "test:performance": "npm run ui:build && node scripts/performance-budget.ts",
    "test:manifest": "node --test test/asset-manifest.test.ts",
    "test:mutation": "node scripts/mutation-check.ts",
    "test:search-open": "node --test test/search-open-budget.test.ts",
    "test:compare": "node --test test/performance-compare.test.ts",
    "test:coverage": "npm run ui:build && node scripts/tokens.ts --check && node scripts/check-design.ts && mkdir -p coverage && node --test --experimental-test-coverage --test-coverage-exclude=\"test/**\" --test-coverage-exclude=\"scripts/**\" --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info \"test/**/*.test.ts\" && npm run coverage:badge",
    "test:coverage:parsers": "node scripts/check-parser-coverage.ts",
    "coverage:badge": "node scripts/coverage-badge.ts coverage/lcov.info coverage/coverage.json",
    "check:design": "node scripts/check-design.ts",
    "check:starters": "node scripts/check-starters.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:changed": "node scripts/test-changed.ts",
    "new:component": "node scripts/new-component.ts",
    "check:inventory": "node --test test/visual/inventory.test.ts",
    "test:release": "node --test test/release-candidate.test.ts",
    "test:ledger": "node --test test/release-ledger.test.ts",
    "release:candidate": "node scripts/release-candidate.ts"
  },
  "dependencies": {
    "@velella/mizzen": "^0.2.5",
    "jsdom": "^31.0.1",
    "lucide": "1.76.0",
    "mermaid": "^12.3.0",
    "preact-render-to-string": "^6.8.3",
    "shiki": "^4.6.0"
  },
  "peerDependencies": {
    "playwright": "^1.65.1",
    "preact": "^11.2.0"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@tailwindcss/cli": "4.3.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "ajv": "^8.20.0",
    "chart.js": "4.6.1",
    "esbuild": "0.28.2",
    "playwright": "1.65.1",
    "preact": "^11.2.0",
    "tailwindcss": "4.3.5",
    "typescript": "^7.0.2",
    "yaml": "^2.9.1"
  },
  "files": [
    "src",
    "visual",
    "schema",
    "scripts/visual-compare.ts",
    "scripts/visual-review.ts",
    "layouts",
    "chrome",
    "components",
    "styles",
    "tokens",
    "fonts",
    "i18n",
    "skills",
    "starters",
    "!skills/*-workspace",
    "!skills/**/evals",
    "!styles/src",
    "!components/*/README.md",
    "!chrome/*/README.md",
    "CHANGELOG.md",
    "components/performance-chart/chart.min.js",
    "styles/generated.css"
  ],
  "publishConfig": {
    "access": "public"
  }
}
