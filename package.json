{
  "name": "@velella/lateen",
  "version": "0.2.3",
  "description": "A docs theme for people and agents, built on Mizzen.",
  "keywords": [
    "docs",
    "documentation",
    "markdown",
    "static-site",
    "agents",
    "velella",
    "theme",
    "rtl",
    "accessibility",
    "wcag"
  ],
  "homepage": "https://velella.sh/lateen/",
  "bugs": {
    "url": "https://github.com/velella-sh/lateen/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/velella-sh/lateen.git"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": "./src/index.ts",
    "./redesign": "./redesign/src/index.ts",
    "./visual": "./visual/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "tokens": "node scripts/tokens.ts",
    "tokens:check": "node scripts/tokens.ts --check",
    "ui:css": "tailwindcss -i styles/src/ui.css -o styles/generated.css --minify",
    "ui:assets": "node --input-type=module -e \"import { copyFileSync, mkdirSync } from 'node:fs'; mkdirSync('components/performance-chart', { recursive: true }); copyFileSync('node_modules/chart.js/dist/chart.umd.min.js', 'components/performance-chart/chart.umd.min.js')\"",
    "ui:build": "npm run ui:css && npm run ui:assets",
    "dev:redesign": "npm run ui:build && mizzen dev redesign/site --theme . --port 4173",
    "build:redesign": "npm run ui:build && mizzen build redesign/site --out redesign/dist --theme .",
    "check:redesign": "npm run ui:build && mizzen check redesign/site --theme .",
    "test:redesign": "node --test \"redesign/test/*.test.ts\"",
    "pretest": "npm run ui:build",
    "test": "npm run ui:build && node scripts/tokens.ts --check && node scripts/check-design.ts && node --test \"test/**/*.test.ts\" && npm run test:redesign",
    "test:a11y": "npm run ui:build && node scripts/test-a11y.ts",
    "test:acceptance": "npm run ui:build && node scripts/acceptance.ts",
    "test:visual": "npm run ui:build && node scripts/test-visual.ts",
    "test:performance": "npm run ui:build && node scripts/performance-budget.ts",

    "test:coverage": "node scripts/tokens.ts --check && mkdir -p coverage && node --test --experimental-test-coverage --test-coverage-exclude=\"test/**\" --test-coverage-exclude=\"scripts/**\" --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info \"test/**/*.test.ts\"",
    "coverage:badge": "node scripts/coverage-badge.ts coverage/lcov.info coverage/coverage.json",
    "check:design": "node scripts/check-design.ts",
    "check:starters": "node scripts/check-starters.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@velella/mizzen": "^0.2.5",
    "jsdom": "^31.0.0",
    "lucide": "1.75.0",
    "mermaid": "^12.3.0",
    "shiki": "^4.6.0"
  },
  "peerDependencies": {
    "playwright": "^1.65.0",
    "preact": "^11.2.0"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@tailwindcss/cli": "4.3.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "ajv": "^8.20.0",
    "basecoat-css": "1.1.0",
    "chart.js": "4.6.1",
    "playwright": "1.65.0",
    "preact": "^11.2.0",
    "preact-render-to-string": "^6.8.2",
    "tailwindcss": "4.3.5",
    "typescript": "^7.0.2",
    "yaml": "^2.9.1"
  },
  "files": [
    "src",
    "visual",
    "schema",
    "scripts/visual-compare.ts",
    "scripts/visual-review.ts",
    "layouts",
    "chrome",
    "components",
    "styles",
    "tokens",
    "fonts",
    "i18n",
    "icons",
    "redesign",
    "skills",
    "starters",
    "!redesign/dist",
    "!redesign/styles/generated.css",
    "!redesign/components/performance-chart/chart.umd.min.js",
    "!skills/*-workspace",
    "!skills/**/evals",
    "CHANGELOG.md",
    "!styles/generated.css",
    "!components/performance-chart/chart.umd.min.js"
  ],
  "publishConfig": {
    "access": "public"
  }
}
