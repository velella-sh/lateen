{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "summary", "category", "status", "added", "updated", "weight_grams", "pieces"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "category": { "enum": ["Shelter", "Cooking", "Navigation", "Repair", "Light", "Water"] },
    "status": { "enum": ["in-service", "maintenance", "retired"] },
    "added": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "weight_grams": { "type": "integer", "minimum": 0 },
    "pieces": { "type": "integer", "minimum": 1 },
    "replaced_by": { "type": "string" },
    "companions": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  }
}
