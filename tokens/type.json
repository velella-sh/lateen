{
  "font-body": "Manrope, \"Manrope Fallback\", Vazirmatn, system-ui, sans-serif",
  "font-heading": "Manrope, \"Manrope Fallback\", Vazirmatn, system-ui, sans-serif",
  "font-ui": "Manrope, \"Manrope Fallback\", Vazirmatn, system-ui, sans-serif",
  "font-mono": "JetBrains Mono, \"JetBrains Mono Fallback\", ui-monospace, monospace",
  "size-xs": "clamp(0.75rem, calc(0.7188rem + 0.1042vw), 0.8125rem)",
  "size-sm": "clamp(0.8125rem, calc(0.7812rem + 0.1042vw), 0.875rem)",
  "size-base": "1.0625rem",
