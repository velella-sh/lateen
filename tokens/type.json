  "size-2xl": "clamp(1.75rem, calc(1.625rem + 0.4167vw), 2rem)",
  "size-3xl": "clamp(2.25rem, calc(2.125rem + 0.4167vw), 2.5rem)",
  "size-display": "clamp(2.5rem, calc(1.9rem + 2.8vw), 4.5rem)",
  "leading-body": "1.65",
