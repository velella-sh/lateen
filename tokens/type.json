  "h2-leading": "{type.leading-heading}",
  "h2-tracking": "{type.tracking-heading}",
  "h2-space-above": "2.25rem",
  "h2-space-below": "1rem",
  "h3-size": "{type.size-xl}",
  "h3-weight": "600",
  "h3-leading": "{type.leading-snug}",
  "h3-tracking": "{type.tracking-heading}",
  "h3-space-above": "2rem",
  "h3-space-below": "0.75rem",
  "h4-size": "{type.size-base}",
  "h4-weight": "600",
