  "leading-display": "1.1",
  "leading-snug": "1.3",
  "leading-ui": "1.5",
  "measure": "66ch",
  "display-size": "{type.size-display}",
  "display-weight": "700",
  "display-leading": "{type.leading-display}",
  "display-tracking": "{type.tracking-display}",
  "h1-size": "{type.size-3xl}",
  "h1-weight": "700",
  "h1-leading": "{type.leading-heading}",
  "h1-tracking": "{type.tracking-display}",
  "h1-space-above": "2.5rem",
  "h1-space-below": "1.5rem",
  "h2-size": "{type.size-2xl}",
