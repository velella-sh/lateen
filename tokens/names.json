  "motion": {
    "fast": "100ms",
    "base": "200ms",
    "slow": "400ms",
    "ease": "cubic-bezier(0.2, 0, 0, 1)",
    "ease-in-out": "cubic-bezier(0.4, 0, 0.2, 1)",
    "ease-out": {
      "$value": "cubic-bezier(0, 0, 0.2, 1)",
      "$extensions": {
        "lateen": {
          "reduced": "linear"
        }
      }
    },
    "ease-in": {
      "$value": "cubic-bezier(0.4, 0, 1, 1)",
      "$extensions": {
        "lateen": {
          "reduced": "linear"
        }
      }
    },
    "press": {
      "$value": "60ms",
      "$extensions": {
        "lateen": {
          "reduced": "0ms"
        }
      }
    }
  },
